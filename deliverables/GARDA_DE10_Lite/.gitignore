# Quartus working database and scratch (regenerated by scripts/build.py)
quartus/db/
quartus/incremental_db/
quartus/output_files/
quartus/*.log
quartus/*.txt
quartus/*.smsg
quartus/*.jdi
quartus/*.qws
# RTL simulation scratch (regenerated by scripts/run_sim.py)
sim/build/
# Python caches and per-session UART logs
__pycache__/
logs/
# Superseded bitstreams; the final release is kept in output/
output/*bringup*
output/*TIMING_NOT_MET*
output/release_0x6AF45*
output/release_0x6AF4647F/
